# ============================================================
# AutoInsight 开发环境变量
# ============================================================

# 真实后端基地址：开发期通过 Vite proxy 转发 /api -> 后端（见 VITE_DEV_PROXY_TARGET）
VITE_API_BASE_URL=/api

# 关闭 Mock，直接请求真实后端
VITE_USE_MOCK=false

# Mock 模拟网络延迟（毫秒）
VITE_MOCK_DELAY=200

# 平台名称
VITE_APP_TITLE=AutoInsight

# 开发期 /api 代理目标（本地后端，已导入真实数据）
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8899
